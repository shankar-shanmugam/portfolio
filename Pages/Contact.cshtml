@page
@model ContactModel
@{
    ViewData["Title"] = "Contact";
}

<section class="page-hero">
    <div class="shell">
        <p class="eyebrow">Contact</p>
        <h1>Get in touch</h1>
        <p class="page-lead">Currently employed and open to .NET Developer and Backend .NET Developer opportunities in Coimbatore, Chennai and Bangalore.</p>
    </div>
</section>

<section class="section">
    <div class="shell contact-grid">
        <div>
            <h2>Direct links</h2>
            <ul class="plain-links">
                <li><a href="mailto:shankar89479@gmail.com">shankar89479@gmail.com</a></li>
                <li><a href="tel:+916380389479">+91 6380389479</a></li>
                <li><a href="https://www.linkedin.com/in/shankar-s-147b31232" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
                <li><a href="https://github.com/shankar-shanmugam" target="_blank" rel="noopener noreferrer">GitHub</a></li>
                <li><a href="~/resume/Shankar-S-Resume.pdf" download>Download resume</a></li>
            </ul>
        </div>

        <div>
            <h2>Send a message</h2>

            @if (Model.Submitted)
            {
                <div class="alert alert-success" role="status">
                    Thanks — your message was received. I will get back to you by email.
                </div>
            }

            <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"></div>

            <form method="post" class="contact-form" novalidate>
                @Html.AntiForgeryToken()

                <div class="field">
                    <label asp-for="ContactForm.Name"></label>
                    <input asp-for="ContactForm.Name" autocomplete="name" />
                    <span asp-validation-for="ContactForm.Name" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="ContactForm.Email"></label>
                    <input asp-for="ContactForm.Email" autocomplete="email" />
                    <span asp-validation-for="ContactForm.Email" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="ContactForm.Company"></label>
                    <input asp-for="ContactForm.Company" autocomplete="organization" />
                    <span asp-validation-for="ContactForm.Company" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="ContactForm.Subject"></label>
                    <input asp-for="ContactForm.Subject" />
                    <span asp-validation-for="ContactForm.Subject" class="field-error"></span>
                </div>

                <div class="field">
                    <label asp-for="ContactForm.Message"></label>
                    <textarea asp-for="ContactForm.Message" rows="6"></textarea>
                    <span asp-validation-for="ContactForm.Message" class="field-error"></span>
                </div>

                <button type="submit" class="btn btn-primary">Send message</button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
